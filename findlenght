#include <stdio.h>
#include <stdlib.h>

// Structure for a node in the linked list
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* createNode(int data) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (!newNode) { // Memory allocation check
        printf("Memory allocation failed!\n");
        exit(1);
    }
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}

// Iterative function to count nodes
int getLengthIterative(struct Node* head) {
    int count = 0;
    struct Node* current = head;
    while (current != NULL) {
        count++;
        current = current->next;
    }
    return count;
}

// Recursive function to count nodes
int getLengthRecursive(struct Node* head) {
    if (head == NULL)
        return 0;
    return 1 + getLengthRecursive(head->next);
}

// Function to free the linked list memory
void freeList(struct Node* head) {
    struct Node* temp;
    while (head != NULL) {
        temp = head;
        head = head->next;
        free(temp);
    }
}

int main() {
    struct Node* head = NULL;
    struct Node* tail = NULL;
    int n, value;

    printf("Enter number of nodes: ");
    if (scanf("%d", &n) != 1 || n < 0) {
        printf("Invalid input. Please enter a non-negative integer.\n");
        return 1;
    }

    // Create linked list
    for (int i = 0; i < n; i++) {
        printf("Enter value for node %d: ", i + 1);
        if (scanf("%d", &value) != 1) {
            printf("Invalid input. Please enter integers only.\n");
            freeList(head);
            return 1;
        }
        struct Node* newNode = createNode(value);
        if (head == NULL) {
            head = tail = newNode;
        } else {
            tail->next = newNode;
            tail = newNode;
        }
    }

    // Display lengths
    printf("\nLength (Iterative): %d\n", getLengthIterative(head));
    printf("Length (Recursive): %d\n", getLengthRecursive(head));

    // Free allocated memory
    freeList(head);

    return 0;
}
